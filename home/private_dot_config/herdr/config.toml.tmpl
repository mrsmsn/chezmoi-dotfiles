{{- /* マシン別の accent 配色 (mac-mini-m4=緑 / 他=紫) */ -}}
{{- $accent := "#5f5f87" -}}
{{- if eq .machine "mac-mini-m4" -}}{{- $accent = "#00af87" -}}{{- end -}}
# 新規マシンで初回起動時の通知設定ウィザードを出さない
onboarding = false

[theme]
# starship と同系の Tokyo Night パレット
name = "tokyo-night"

[ui]
accent = "{{ $accent }}"
prompt_new_tab_name = false
show_agent_labels_on_pane_borders = true

# herdr デフォルトと一致するキーバインド (h/j/k/l ペイン移動・c 新タブなど) は設定しない。
[keys]
prefix = "ctrl+f"

previous_tab = "prefix+ctrl+h"
next_tab = "prefix+ctrl+l"

split_horizontal = "prefix+minus"
split_vertical = "prefix+|"

# デフォルトの split_vertical=prefix+v は上で退避済み。
copy_mode = "prefix+v"

# herdr 0.7.1 の [keys] にペーストアクションが無いため、クリップボードを
# send-text する自前スクリプトで代替する。
# デフォルトの previous_tab=prefix+p は上で退避済み。
[[keys.command]]
key = "prefix+p"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/paste.sh"
description = "paste clipboard"

# herdr は CSI-u の ctrl+/ を '/' に化けさせるため、^_ (0x1f) に変換して
# ペインへ送り直す (zsh の fzf-src バインド用)
[[keys.command]]
key = "ctrl+/"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/forward-ctrl-slash.sh"
description = "forward ctrl+/ to pane as ^_"

# コピーモードで y した後に prefix+t で翻訳ポップアップ
[[keys.command]]
key = "prefix+t"
type = "plugin_action"
command = "mrsmsn.translator.translate"
description = "translate selection/clipboard"
