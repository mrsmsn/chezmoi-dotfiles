// niri config (KDL) — https://yalter.github.io/niri/
//
// このファイルは chezmoi 管理 (home/private_dot_config/niri/config.kdl)。
// niri-flake の home-manager settings は使わないので型検証は効かない。
// 変更後は実機で `niri validate` を実行して構文を確認すること。
//
// CapsLock -> Ctrl は NixOS の xremap (system モード) が担うので niri 側では扱わない。
// Mod は Super (Windows キー)。

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// サーバーサイド装飾を好む (ウィンドウ側の余計なタイトルバーを避ける)。
prefer-no-csd

// スクリーンショットの保存先。
screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

// ---- 自動起動 ----
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-c" "#1a1b26"
spawn-at-startup "swayidle" "-w" \
    "timeout" "300" "swaylock -f" \
    "timeout" "600" "niri msg action power-off-monitors" \
    "resume"       "niri msg action power-on-monitors" \
    "before-sleep" "swaylock -f"
// fcitx5: init タイミング問題 (niri#2283) が出る場合は systemd user service
// 化や遅延起動に切り替える。
spawn-at-startup "fcitx5" "-d" "--replace"

// ---- キーバインド ----
binds {
    // ヘルプ (バインド一覧)
    Mod+Shift+Slash { show-hotkey-overlay; }

    // アプリ起動
    Mod+Return hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }
    Mod+D      hotkey-overlay-title="Launcher: fuzzel"   { spawn "fuzzel"; }
    Mod+Escape hotkey-overlay-title="Lock: swaylock"     { spawn "swaylock" "-f"; }

    // ウィンドウ操作
    Mod+Q { close-window; }

    // フォーカス移動
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // ウィンドウ移動
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // ワークスペース
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // レイアウト
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // スクリーンショット
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // 音量 (PipeWire / wpctl)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // 終了
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
