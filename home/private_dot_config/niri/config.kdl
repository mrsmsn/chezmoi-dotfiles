// niri config (KDL) — https://yalter.github.io/niri/
//
// このファイルは chezmoi 管理 (home/private_dot_config/niri/config.kdl)。
// niri-flake の home-manager settings は使わないので型検証は効かない。
// 変更後は実機で `niri validate` を実行して構文を確認すること。
//
// CapsLock -> Ctrl は NixOS の xremap (system モード) が担うので niri 側では扱わない。
// Mod は Super (Windows キー)。

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// サーバーサイド装飾を好む (ウィンドウ側の余計なタイトルバーを避ける)。
prefer-no-csd

// ---- レイアウト ----
layout {
    // 空 {} だと既定プリセットに戻るので proportion を明示する。
    default-column-width { proportion 0.96; }
    // 直前の列と並べて画面に収まらない幅の窓 (0.96 等) は中央、収まる窓 (0.5 等) は端寄せ。
    center-focused-column "on-overflow"

    // フォーカス窓だけを囲むリング。全窓に出る border とは別物 (border は既定 off のまま)。
    focus-ring {
        width 3
    }

    // Mod+R (switch-preset-column-width) が循環する幅。先頭に 0.96 を置き、
    // 押し続ければデフォルト幅に戻れるようにする。
    preset-column-widths {
        proportion 0.96
        proportion 0.5
        proportion 0.33333
    }
}

// ---- ウィンドウルール ----
window-rule {
    geometry-corner-radius 12
    // これが無いと角丸はボーダー描画だけに効き、ウィンドウ内容の角は四角のまま。
    clip-to-geometry true
}

// スクリーンショットの保存先。
screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

// ---- 自動起動 ----
// Noctalia デスクトップシェル (バー/ランチャー/通知/ロック/壁紙/OSD を統合)。
spawn-at-startup "noctalia"
// fcitx5: init タイミング問題 (niri#2283) が出る場合は systemd user service
// 化や遅延起動に切り替える。
spawn-at-startup "fcitx5" "-d" "--replace"

// ---- キーバインド ----
binds {
    // ヘルプ (バインド一覧)
    Mod+Shift+Slash { show-hotkey-overlay; }

    // アプリ起動 / Noctalia シェル操作 (IPC は `noctalia msg ...`)
    Mod+Return  hotkey-overlay-title="Terminal: ghostty"  { spawn "ghostty"; }
    Mod+D       hotkey-overlay-title="Launcher"           { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S       hotkey-overlay-title="Control Center"     { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+S hotkey-overlay-title="Noctalia Settings"  { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Escape  hotkey-overlay-title="Lock"               { spawn-sh "noctalia msg session lock"; }

    // ウィンドウ操作
    Mod+Q { close-window; }

    // フォーカス移動
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // ウィンドウ移動
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // ワークスペース
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // レイアウト
    Mod+R { switch-preset-column-width; }
    // Mod+C hotkey-overlay-title="Center column" { center-column; } // windowをセンターにするショートカット
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // スクリーンショット
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // 音量 (PipeWire / wpctl)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // 終了
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
