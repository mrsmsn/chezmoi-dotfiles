{{- /* OS アイコン: darwin= (Apple), wsl= (Windows), nixos= (NixOS), linux= (Ubuntu), その他= (Tux) */ -}}
{{- $os_icon := "" -}}
{{- if eq .variant "darwin" -}}{{- $os_icon = "" -}}
{{- else if eq .variant "wsl" -}}{{- $os_icon = "" -}}
{{- else if eq .variant "nixos" -}}{{- $os_icon = "" -}}
{{- else if eq .variant "linux" -}}{{- $os_icon = "" -}}
{{- end -}}
{{- /* 配色は home/.chezmoidata/colors.toml で一元管理 (hex 直書き禁止) */ -}}
{{- $c := index .colors.palettes .machine | default .colors.palettes.default }}
## プロンプト間の空行は zsh 側の precmd で入れる (init.zsh 参照)。
## add_newline だと起動直後の最初のプロンプトにも空行が付いてしまうため。
add_newline = false
format = """
[░▒▓]({{ $c.accent_subtle }})\
[ {{ $os_icon }} ](bg:{{ $c.accent_subtle }} fg:{{ .colors.common.on_subtle }})\
[](bg:{{ $c.accent }} fg:{{ $c.accent_subtle }})\
$directory\
[](fg:{{ $c.accent }} bg:{{ $c.surface1 }})\
$git_branch\
$git_status\
[](fg:{{ $c.surface1 }} bg:{{ $c.surface2 }})\
$nodejs\
$rust\
$golang\
$php\
[](fg:{{ $c.surface2 }} bg:{{ $c.surface3 }})\
$time\
[ ](fg:{{ $c.surface3 }})\
\n$character"""

[directory]
style = "fg:{{ .colors.common.on_accent }} bg:{{ $c.accent }}"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "

[git_branch]
symbol = ""
style = "bg:{{ $c.surface1 }}"
format = '[[ $symbol $branch ](fg:{{ $c.fg_accent }} bg:{{ $c.surface1 }})]($style)'

[git_status]
style = "bg:{{ $c.surface1 }}"
format = '[[($all_status$ahead_behind )](fg:{{ $c.fg_accent }} bg:{{ $c.surface1 }})]($style)'

[nodejs]
symbol = ""
style = "bg:{{ $c.surface2 }}"
format = '[[ $symbol ($version) ](fg:{{ $c.fg_accent }} bg:{{ $c.surface2 }})]($style)'

[rust]
symbol = ""
style = "bg:{{ $c.surface2 }}"
format = '[[ $symbol ($version) ](fg:{{ $c.fg_accent }} bg:{{ $c.surface2 }})]($style)'

[golang]
symbol = ""
style = "bg:{{ $c.surface2 }}"
format = '[[ $symbol ($version) ](fg:{{ $c.fg_accent }} bg:{{ $c.surface2 }})]($style)'

[php]
symbol = ""
style = "bg:{{ $c.surface2 }}"
format = '[[ $symbol ($version) ](fg:{{ $c.fg_accent }} bg:{{ $c.surface2 }})]($style)'

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "bg:{{ $c.surface3 }}"
format = '[[  $time ](fg:{{ $c.fg_time }} bg:{{ $c.surface3 }})]($style)'
