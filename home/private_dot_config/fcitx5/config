[Hotkey]
EnumerateWithTriggerKeys=True
EnumerateSkipFirst=False
ModifierOnlyKeyTimeout=250

# Hangul は Mozc の IMEOn 用なので Trigger からは外す (衝突回避)。
[Hotkey/TriggerKeys]
0=Control+space
1=Zenkaku_Hankaku

# kanata が左Alt 単押しで Hangul_Hanja、右Alt 単押しで Hangul を送出する
# (nix/nixos/kanata.nix)。IM グループは mozc 1 個だけなので fcitx5 自身の
# Activate/Deactivate は成立せず (IM 2 個以上が条件)、これらのキーは fcitx5 を
# 素通りして fcitx5-mozc が Mozc の ON/OFF キーに変換する:
#   Hangul       -> Mozc IMEOn  = かな (InitialMode=Hiragana は conf/mozc.conf)
#   Hangul_Hanja -> Mozc IMEOff = Direct (英数)
# ActivateKeys/DeactivateKeys は IM を増やしたときにそのまま効くよう残す。
[Hotkey/ActivateKeys]
0=Hangul

[Hotkey/DeactivateKeys]
0=Hangul_Hanja

[Hotkey/AltTriggerKeys]
0=Shift_L

[Hotkey/EnumerateForwardKeys]
0=Alt+Alt_L

[Hotkey/EnumerateBackwardKeys]

[Hotkey/EnumerateGroupForwardKeys]
0=Super+space

[Hotkey/EnumerateGroupBackwardKeys]
0=Shift+Super+space

[Hotkey/PrevPage]
0=Up

[Hotkey/NextPage]
0=Down

[Hotkey/PrevCandidate]
0=Shift+Tab

[Hotkey/NextCandidate]
0=Tab

[Hotkey/TogglePreedit]
0=Control+Alt+P

[Behavior]
ActiveByDefault=False
resetStateWhenFocusIn=No
ShareInputState=No
PreeditEnabledByDefault=True
ShowInputMethodInformation=True
showInputMethodInformationWhenFocusIn=False
CompactInputMethodInformation=True
ShowFirstInputMethodInformation=True
DefaultPageSize=5
OverrideXkbOption=False
CustomXkbOption=
EnabledAddons=
DisabledAddons=
PreloadInputMethod=True
AllowInputMethodForPassword=False
ShowPreeditForPassword=False
AutoSavePeriod=30
