[ghq]
    root = {{ .ghq.root }}

[user]
    name = {{ .git.user_name | quote }}
    email = {{ .git.user_email | quote }}

[core]
    excludesfile = ~/.gitignore_global
{{- if .git.ssh_key }}
    sshCommand = "ssh -i ~/.ssh/{{ .git.ssh_key }} -o IdentitiesOnly=yes"
{{- end }}
{{ if .work.gitdir_prefix }}
# Work プロファイル: gitdir が一致したら ~/.config/git/config_work を上書き読み込み。
# config_work は git/config_work.tmpl から prompt 値で生成される。
[includeIf "gitdir:{{ .work.gitdir_prefix }}"]
    path = ~/.config/git/config_work
{{- end }}
