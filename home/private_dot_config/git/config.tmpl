[ghq]
    root = {{ .ghq.root }}

[user]
    name = {{ .git.user_name | quote }}
    email = {{ .git.user_email | quote }}

[core]
    excludesfile = ~/.gitignore_global
{{- if .git.ssh_key }}
    sshCommand = "ssh -i ~/.ssh/{{ .git.ssh_key }} -o IdentitiesOnly=yes"
{{- end }}

# osxkeychain 等が先に答えないよう空 helper で chain を一度リセット。`gh auth
# setup-git` は /nix/store/... の絶対パスを書いて Nix 環境で壊れるので、PATH
# 解決の `gh` だけを書く (gh のバージョン更新でも壊れない)。
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
{{ if .work.gitdir_prefix }}
[includeIf "gitdir:{{ .work.gitdir_prefix }}"]
    path = ~/.config/git/config_work
{{- end }}
{{- if .work.gh_user }}
# work GitHub アカウント名義の clone 先も work プロファイル扱い。
[includeIf "gitdir:{{ .ghq.root }}/github.com/{{ .work.gh_user }}/"]
    path = ~/.config/git/config_work
{{- end }}
