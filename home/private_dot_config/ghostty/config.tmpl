theme = TokyoNight

background-opacity = 0.9

mouse-hide-while-typing = true

# SSH 接続時に xterm-ghostty terminfo をリモートへ自動配布
# (リモートで `missing or unsuitable terminal: xterm-ghostty` を防ぐ)
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Ctrl+Tab / Ctrl+Shift+Tab は Ghostty のタブ切替から外し、
# herdr のタブ切替 (next_tab/previous_tab) へパススルーさせる
keybind = "ctrl+tab=unbind"
keybind = "ctrl+shift+tab=unbind"

{{ if eq .variant "darwin" -}}
macos-titlebar-style = hidden

# QuickTerm (global keybind は macOS のみ対応)
quick-terminal-position = "center"
quick-terminal-size = 50%,60%
quick-terminal-screen = "main"
quick-terminal-animation-duration = 0.2
keybind = "global:ctrl+shift+t=toggle_quick_terminal"
{{- end }}
