#!/usr/bin/env bash
# herdr-config-hash: {{ include "private_dot_config/herdr/config.toml.tmpl" | sha256sum }}
#
# herdr-translator (github.com/mrsmsn/herdr-translator) を herdr に登録する。
# REF を上げるとこのスクリプトの内容が変わり run_onchange が再実行 →
# 再 install (= managed checkout の置換 = 更新) される契約。先頭のハッシュは
# config.toml のキーバインド変更で reload-config を走らせるためのもの。
set -eu

REF="v0.1.0"

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr not found; skip herdr plugin bootstrap"
  exit 0
fi

plugins_json="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins.json"

# ローカル link 登録が残っていると GitHub からの install は拒否されるため、
# 該当エントリがあるときだけ unlink する (install 済みエントリには触らない)
if command -v jq >/dev/null 2>&1 \
  && jq -e '.[] | select(.plugin_id == "mrsmsn.translator" and .source.kind == "local")' \
       "$plugins_json" >/dev/null 2>&1; then
  herdr plugin unlink mrsmsn.translator >/dev/null 2>&1 || true
fi

# install はサーバ未起動でも登録できる (herdr docs)。失敗時は exit 1 にして
# 次回 chezmoi apply で自動リトライさせる
if ! herdr plugin install mrsmsn/herdr-translator --ref "$REF" --yes; then
  echo "herdr plugin install failed; will retry on next chezmoi apply" >&2
  exit 1
fi

# 実行中サーバがあればキーバインド変更を反映 (未起動なら次回起動時に読まれる)
herdr server reload-config >/dev/null 2>&1 || true
