#!/usr/bin/env bash
# 出力先パス自体が user の ghq.root / work org 名等を含むため source tree (=
# public repo) に書けない。apply 時に chezmoi.toml の値を読んで動的に組み立てる。
# trigger-on: {{ .ghq.root }}|{{ .git.gh_user_default }}|{{ .work.gitdir_prefix }}|{{ .work.gh_user }}
set -euo pipefail

# Personal: <ghq.root>/.envrc
# .envrc 本体は SRC_HOME export で、use_gh_user 呼び出しはオプション。両方必須に
# すると bootstrap で gh_user_default を空 enter した瞬間に .envrc が一切生成
# されなくなる。
{{ if .ghq.root -}}
GHQ_ROOT={{ .ghq.root | replace "~" .chezmoi.homeDir | quote }}
mkdir -p "${GHQ_ROOT}"

cat > "${GHQ_ROOT}/.envrc" <<EOF
# Auto-generated by chezmoi (run_onchange_30-write-envrcs.sh.tmpl).
# 手で書き換えても次回 apply で上書きされる。
{{ if .git.gh_user_default -}}
use_gh_user "{{ .git.gh_user_default }}"
{{ end -}}
export SRC_HOME="${GHQ_ROOT}"
EOF

echo "==> wrote ${GHQ_ROOT}/.envrc"
{{- end }}

# Work ghq-aliased: <ghq.root>/github.com/<work.gh_user>/.envrc
# config.tmpl の `[includeIf "gitdir:<ghq.root>/github.com/<work.gh_user>/"]` と
# 対をなす direnv 側の work プロファイル。
{{ if and .ghq.root .work.gh_user -}}
WORK_GHQ_PREFIX={{ (printf "%s/github.com/%s/" .ghq.root .work.gh_user) | replace "~" .chezmoi.homeDir | quote }}
mkdir -p "${WORK_GHQ_PREFIX}"

cat > "${WORK_GHQ_PREFIX}/.envrc" <<'EOF'
# Auto-generated by chezmoi (run_onchange_30-write-envrcs.sh.tmpl).
# 手で書き換えても次回 apply で上書きされる。
use_gh_user {{ .work.gh_user | quote }}
export GITHUB_APM_PAT="$(gh auth token)"
EOF

echo "==> wrote ${WORK_GHQ_PREFIX}/.envrc"
{{- end }}

# Work: <work.gitdir_prefix>/.envrc
# personal 側と同じく、.envrc 本体と use_gh_user 行を独立条件で出し分ける。
{{ if .work.gitdir_prefix -}}
WORK_PREFIX={{ .work.gitdir_prefix | replace "~" .chezmoi.homeDir | quote }}
mkdir -p "${WORK_PREFIX}"

cat > "${WORK_PREFIX}/.envrc" <<'EOF'
# Auto-generated by chezmoi (run_onchange_30-write-envrcs.sh.tmpl).
# 手で書き換えても次回 apply で上書きされる。
{{ if .work.gh_user -}}
use_gh_user {{ .work.gh_user | quote }}
{{ end -}}
export GITHUB_APM_PAT="$(gh auth token)"
EOF

echo "==> wrote ${WORK_PREFIX}/.envrc"
echo "    'cd ${WORK_PREFIX}' して 'direnv allow' で有効化してください"
{{- end }}
