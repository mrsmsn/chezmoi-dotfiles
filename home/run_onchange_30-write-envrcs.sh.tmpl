#!/usr/bin/env bash
# ghq tree のルートと、work プロファイル ON 時の work prefix に、それぞれ
# .envrc を生成する。出力先パス自体が user の ghq.root / work org 名等を
# 含むため source tree (= public repo) に書けない。run_onchange スクリプト
# が apply 時に chezmoi.toml の値を読んで動的に組み立てる。
# trigger-on: {{ .ghq.root }}|{{ .git.gh_user_default }}|{{ .work.gitdir_prefix }}|{{ .work.gh_user }}
set -euo pipefail

# Personal: <ghq.root>/.envrc — ghq tree の defaults。
# `.ghq.root` だけ set されていれば書く。`gh_user_default` は use_gh_user
# 行のみに使い、未設定なら行ごと省く (新マシン bootstrap で gh_user_default
# を空 enter したときに .envrc 自体が生成されない事故の修正)。
{{ if .ghq.root -}}
GHQ_ROOT={{ .ghq.root | replace "~" .chezmoi.homeDir | quote }}
mkdir -p "${GHQ_ROOT}"

cat > "${GHQ_ROOT}/.envrc" <<EOF
# Auto-generated by chezmoi (run_onchange_30-write-envrcs.sh.tmpl).
# 手で書き換えても次回 apply で上書きされる。
{{ if .git.gh_user_default -}}
use_gh_user "{{ .git.gh_user_default }}"
{{ end -}}
export SRC_HOME="${GHQ_ROOT}"
EOF

echo "==> wrote ${GHQ_ROOT}/.envrc"
{{- end }}

# Work: <work.gitdir_prefix>/.envrc — work プロファイル上書き。
{{ if and .work.gitdir_prefix .work.gh_user -}}
WORK_PREFIX={{ .work.gitdir_prefix | replace "~" .chezmoi.homeDir | quote }}
mkdir -p "${WORK_PREFIX}"

cat > "${WORK_PREFIX}/.envrc" <<'EOF'
# Auto-generated by chezmoi (run_onchange_30-write-envrcs.sh.tmpl).
# 手で書き換えても次回 apply で上書きされる。
use_gh_user {{ .work.gh_user | quote }}
export GITHUB_APM_PAT="$(gh auth token)"
EOF

echo "==> wrote ${WORK_PREFIX}/.envrc"
echo "    'cd ${WORK_PREFIX}' して 'direnv allow' で有効化してください"
{{- end }}
