#!/usr/bin/env bash
# tmux-conf-hash: {{ include "private_dot_config/tmux/tmux.conf.tmpl" | sha256sum }}
#
# TPM (tmux plugin manager) をブートストラップし、tmux.conf で宣言した
# プラグイン (tmux-translator など) を非対話でインストールする。
#
# 先頭の tmux-conf-hash には tmux.conf.tmpl の内容ハッシュを埋め込んでいる。
# tmux.conf を編集して @plugin を増減すると、このスクリプト自体のハッシュも
# 変わり chezmoi が run_onchange を再実行 → install_plugins が走る、という契約。
set -eu

plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins"
tpm_path="${plugins_dir}/tpm"

if ! command -v git >/dev/null 2>&1; then
  echo "git not found; skip tmux plugin bootstrap"
  exit 0
fi

if [ ! -d "${tpm_path}/.git" ]; then
  echo "Installing TPM into ${tpm_path}"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "${tpm_path}"
fi

if command -v tmux >/dev/null 2>&1; then
  echo "Installing tmux plugins via TPM"
  TMUX_PLUGIN_MANAGER_PATH="${plugins_dir}/" "${tpm_path}/bin/install_plugins" ||
    echo "TPM install_plugins failed; run 'prefix + I' inside tmux to retry."
else
  echo "tmux not found; TPM cloned. Run 'prefix + I' inside tmux to install plugins."
fi
