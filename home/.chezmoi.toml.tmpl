{{- /* Mac mini (M4 / M4 Pro) のみ machine = "mac-mini-m4" をセット。
       それ以外の機種は空文字のままで、利用側の else 分岐にフォールバックさせる。
       model は機種追加時のデバッグ用にデータとして残す。 */ -}}
{{- $variant := "linux" -}}
{{- $model := "" -}}
{{- $machine := "" -}}

{{- if eq .chezmoi.os "darwin" -}}
{{-   $variant = "darwin" -}}
{{-   $model = output "sh" "-c" "sysctl -n hw.model 2>/dev/null || true" | trim -}}
{{-   if or (eq $model "Mac16,10") (eq $model "Mac16,11") -}}
{{-     $machine = "mac-mini-m4" -}}
{{-   end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{-     $variant = "wsl" -}}
{{-   end -}}
{{- end -}}

{{- /* 個人/work 値: 初回 apply 時だけ対話で聞かれ、~/.config/chezmoi/chezmoi.toml に永続化される。
       repo (= source tree) には絶対に出ない。 */ -}}
{{- /* default は全部空。--no-tty 環境 (CI / bootstrap) でも apply が止まらないようにするため。
       interactive な初回 apply で空のまま enter すると `name = ""` が target に出るので user は気付ける。 */ -}}
{{- $userName         := promptStringOnce . "git.user_name"        "git commit の author 名 (例: mrsmsn)" "" -}}
{{- $userEmail        := promptStringOnce . "git.user_email"       "git commit の email" "" -}}
{{- $ghUserDefault    := promptStringOnce . "git.gh_user_default"  "普段使う GitHub アカウント名 (gh CLI 用)" "" -}}
{{- $sshKey           := promptStringOnce . "git.ssh_key"          "git で使う SSH 鍵のファイル名 (~/.ssh/ 配下、空ならデフォルト鍵)" "" -}}
{{- $ghqRoot          := promptStringOnce . "ghq.root"             "ghq の clone 先ディレクトリ" "~/src" -}}
{{- $workGitdirPrefix := promptStringOnce . "work.gitdir_prefix"   "work アカウントに切り替える起点パス (例: ~/src/github.com/<work-org>/、空欄なら work 機能 OFF)" "" -}}

{{- /* work プロファイル有効時のみ追加で work 用の値を聞く。
       無効時はこれらは空のまま (chezmoiignore で config_work.tmpl ごと target 外す)。 */ -}}
{{- $workUserName  := "" -}}
{{- $workUserEmail := "" -}}
{{- $workSshKey    := "" -}}
{{- $workGhUser    := "" -}}
{{- $workBitbucket := false -}}
{{- if $workGitdirPrefix -}}
{{-   $workUserName  = promptStringOnce . "work.user_name"             "work での git commit の author 名" "" -}}
{{-   $workUserEmail = promptStringOnce . "work.user_email"            "work での git commit の email" "" -}}
{{-   $workSshKey    = promptStringOnce . "work.ssh_key"               "work で使う SSH 鍵のファイル名 (~/.ssh/ 配下、空可)" "" -}}
{{-   $workGhUser    = promptStringOnce . "work.gh_user"               "work で使う GitHub アカウント名 (gh CLI 用)" "" -}}
{{-   $workBitbucket = promptBoolOnce   . "work.bitbucket_ssh_rewrite" "Bitbucket の https URL を ssh URL に書き換える?" false -}}
{{- end -}}

[data]
    os = "{{ .chezmoi.os }}"
    variant = "{{ $variant }}"
    is_wsl = {{ eq $variant "wsl" }}
    model = "{{ $model }}"
    machine = "{{ $machine }}"

    [data.git]
        user_name        = "{{ $userName }}"
        user_email       = "{{ $userEmail }}"
        gh_user_default  = "{{ $ghUserDefault }}"
        ssh_key          = "{{ $sshKey }}"

    [data.ghq]
        root = "{{ $ghqRoot }}"

    [data.work]
        gitdir_prefix         = "{{ $workGitdirPrefix }}"
        user_name             = "{{ $workUserName }}"
        user_email            = "{{ $workUserEmail }}"
        ssh_key               = "{{ $workSshKey }}"
        gh_user               = "{{ $workGhUser }}"
        bitbucket_ssh_rewrite = {{ $workBitbucket }}
