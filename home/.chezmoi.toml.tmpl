{{- /* Mac mini (M4 / M4 Pro) のみ machine = "mac-mini-m4" をセット。
       それ以外の機種は空文字のままで、利用側の else 分岐にフォールバックさせる。
       model は機種追加時のデバッグ用にデータとして残す。 */ -}}
{{- $variant := "linux" -}}
{{- $model := "" -}}
{{- $machine := "" -}}

{{- if eq .chezmoi.os "darwin" -}}
{{-   $variant = "darwin" -}}
{{-   $model = output "sysctl" "-n" "hw.model" | trim -}}
{{-   if or (eq $model "Mac16,10") (eq $model "Mac16,11") -}}
{{-     $machine = "mac-mini-m4" -}}
{{-   end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{-     $variant = "wsl" -}}
{{-   end -}}
{{- end -}}

[data]
    os = "{{ .chezmoi.os }}"
    variant = "{{ $variant }}"
    is_wsl = {{ eq $variant "wsl" }}
    model = "{{ $model }}"
    machine = "{{ $machine }}"
