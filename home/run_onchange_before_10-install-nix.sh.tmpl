#!/usr/bin/env bash
set -euo pipefail

NIX_CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nix"
NIX_CONF="${NIX_CONF_DIR}/nix.conf"
mkdir -p "${NIX_CONF_DIR}"
if ! { [[ -f "${NIX_CONF}" ]] && grep -q '^experimental-features' "${NIX_CONF}"; }; then
    echo "experimental-features = nix-command flakes" >> "${NIX_CONF}"
fi

{{ if eq .variant "darwin" -}}
# NONINTERACTIVE は付けない: 付けると Homebrew installer が `sudo -n` で即チェックし、
# キャッシュ無し環境で "Need sudo access" で落ちる。chezmoi apply は対話 TTY 前提
# なので普通に sudo プロンプトを出させる方が確実。
if ! command -v brew >/dev/null 2>&1 \
    && ! [[ -x /opt/homebrew/bin/brew ]] \
    && ! [[ -x /usr/local/bin/brew ]]; then
    /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{- end }}
