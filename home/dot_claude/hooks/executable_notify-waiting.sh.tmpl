#!/bin/bash
PROJECT_NAME=$(basename "$PWD")
TEXT="${PROJECT_NAME}、入力待ち"
{{ if eq .variant "darwin" -}}
say -v Victoria "$TEXT" || true
{{- else if eq .variant "wsl" -}}
powershell.exe -NoProfile -Command "Add-Type -AssemblyName System.Speech; \$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \$s.Speak('$TEXT')" >/dev/null 2>&1 || true
{{- else -}}
espeak-ng -v ja "$TEXT" >/dev/null 2>&1 || true
{{- end }}
