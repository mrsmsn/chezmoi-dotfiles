{
  "permissions": {
    "deny": [
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)",
      "Bash(gem install:*)",
      "Bash(cargo install:*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "language": "ja",
  "theme": "dark-daltonized",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
