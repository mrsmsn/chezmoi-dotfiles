#!/usr/bin/env bash
# nix-tree-hash: {{ output "git" "-C" (joinPath .chezmoi.sourceDir "..") "rev-parse" "HEAD:nix" | trim }}
set -euo pipefail

FLAKE="{{ .chezmoi.sourceDir }}/../nix"

if [[ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
elif [[ -e "${HOME}/.nix-profile/etc/profile.d/nix.sh" ]]; then
    # shellcheck disable=SC1091
    . "${HOME}/.nix-profile/etc/profile.d/nix.sh"
fi

case "{{ .variant }}" in
    darwin)
        # nix-darwin activation は root で走るので sudo。HOME と USER を pass-through
        # しないと ~/.config/nix/nix.conf と flake.nix の `getEnv "USER"` が壊れる。
        if command -v darwin-rebuild >/dev/null 2>&1; then
            sudo env HOME="$HOME" USER="$USER" \
                "$(command -v darwin-rebuild)" \
                switch --flake "${FLAKE}#default" --impure
        else
            sudo env HOME="$HOME" USER="$USER" \
                /nix/var/nix/profiles/default/bin/nix \
                run nix-darwin -- switch --flake "${FLAKE}#default" --impure
        fi
        ;;
    linux|wsl|android)
        # 自前 flake で pin した home-manager を使うことで、毎回 GitHub API を
        # 叩いて `home-manager/master` を resolve する負荷を避ける。
        nix run "${FLAKE}#home-manager" -- \
            switch -b backup --flake "${FLAKE}#{{ .variant }}" --impure

        # Linux/WSL には nix-darwin の `programs.zsh.enable` 相当が無いので
        # ここで /etc/shells 登録と chsh を行う。home-manager 経由で
        # ~/.nix-profile/bin/zsh が存在する前提。
        ZSH_BIN="${HOME}/.nix-profile/bin/zsh"
        if [[ -x "${ZSH_BIN}" ]]; then
            if ! grep -qxF "${ZSH_BIN}" /etc/shells 2>/dev/null; then
                echo "==> Adding ${ZSH_BIN} to /etc/shells"
                echo "${ZSH_BIN}" | sudo tee -a /etc/shells >/dev/null
            fi
            CURRENT_SHELL="$(awk -F: -v u="$USER" '$1==u{print $7}' /etc/passwd)"
            if [[ "${CURRENT_SHELL}" != "${ZSH_BIN}" ]]; then
                echo "==> Setting default shell to ${ZSH_BIN}"
                sudo chsh -s "${ZSH_BIN}" "$USER"
            fi
        fi
        ;;
    *)
        echo "Unknown variant: {{ .variant }}" >&2
        exit 1
        ;;
esac
