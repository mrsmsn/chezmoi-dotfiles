#!/usr/bin/env bash
# nix-tree-hash: {{ output "git" "-C" (joinPath .chezmoi.sourceDir "..") "rev-parse" "HEAD:nix" | trim }}
set -euo pipefail

FLAKE="{{ .chezmoi.sourceDir }}/../nix"

if [[ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
elif [[ -e "${HOME}/.nix-profile/etc/profile.d/nix.sh" ]]; then
    # shellcheck disable=SC1091
    . "${HOME}/.nix-profile/etc/profile.d/nix.sh"
fi

# 重い input (niri/vicinae/noctalia/llm-agents) のバイナリキャッシュを効かせる。
# flake の nixConfig でも供給できるが、それは実行ユーザーの trusted-settings.json
# (対話プロンプトでの受諾記録) というマシンローカル状態に依存し、無人実行では
# プロンプトが出ず黙って無視される。root(trusted-user) から --option で直接
# 渡せばどちらにも依存せず決定的に適用される。※ この集合は nix/flake.nix の
# nixConfig、nix/nixos/configuration.nix と nix/darwin/configuration.nix の
# nix.settings と同期させること。
EXTRA_SUBS="https://niri.cachix.org https://vicinae.cachix.org https://noctalia.cachix.org https://cache.numtide.com"
EXTRA_KEYS="niri.cachix.org-1:Wv0OmO7PsuocRKzfDoJ3mulSl7Z6oezYhGhR+3W2964= vicinae.cachix.org-1:1kDrfienkGHPYbkpNj1mWTr7Fm1+zcenzgTizIcI3oc= noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4= niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g="

case "{{ .variant }}" in
    darwin)
        # nix-darwin activation は root で走るので sudo。USER を pass-through
        # しないと flake.nix の `getEnv "USER"` が壊れる。HOME も渡すが、
        # darwin-rebuild は内部で HOME=~root にリセットするため、ユーザー側の
        # nix.conf / trusted-settings.json は評価に効かない (--option が必須な理由)。
        if command -v darwin-rebuild >/dev/null 2>&1; then
            sudo env HOME="$HOME" USER="$USER" \
                "$(command -v darwin-rebuild)" \
                switch --flake "${FLAKE}#default" --impure \
                --option extra-substituters "${EXTRA_SUBS}" \
                --option extra-trusted-public-keys "${EXTRA_KEYS}"
        else
            sudo env HOME="$HOME" USER="$USER" \
                /nix/var/nix/profiles/default/bin/nix \
                run nix-darwin -- switch --flake "${FLAKE}#default" --impure \
                --option extra-substituters "${EXTRA_SUBS}" \
                --option extra-trusted-public-keys "${EXTRA_KEYS}"
        fi
        ;;
    nixos)
        # hardware-configuration.nix はリポジトリに置かず /etc/nixos の自動生成物を
        # flake が --impure で参照する。無いまま rebuild すると CI 用 stub が使われ
        # 起動不能なシステムを作りうるので事前チェックする。
        [ -e /etc/nixos/hardware-configuration.nix ] || {
            echo "ERROR: /etc/nixos/hardware-configuration.nix not found (run nixos-generate-config)" >&2
            exit 1
        }
        # darwin と同様 HOME/USER を pass-through (flake の getEnv "USER" 対策)。
        # sudo の secure_path 対策で command -v で解決したフルパスを渡す。
        sudo env HOME="$HOME" USER="$USER" \
            "$(command -v nixos-rebuild)" switch --flake "${FLAKE}#default" --impure \
            --option extra-substituters "${EXTRA_SUBS}" \
            --option extra-trusted-public-keys "${EXTRA_KEYS}"
        # NixOS では /etc/shells が read-only (store へのシンボリックリンク) で
        # chsh も効かない。ログインシェルは programs.zsh.enable +
        # users.users.<name>.shell が system config 側で管理するので、ここでの
        # /etc/shells 登録・chsh は行わない (linux|wsl|android ケースと非対称)。
        ;;
    linux|wsl|android)
        # 自前 flake で pin した home-manager を使うことで、毎回 GitHub API を
        # 叩いて `home-manager/master` を resolve する負荷を避ける。
        nix run "${FLAKE}#home-manager" -- \
            switch -b backup --flake "${FLAKE}#{{ .variant }}" --impure

        # Linux/WSL には nix-darwin の `programs.zsh.enable` 相当が無いので
        # ここで /etc/shells 登録と chsh を行う。home-manager 経由で
        # ~/.nix-profile/bin/zsh が存在する前提。
        ZSH_BIN="${HOME}/.nix-profile/bin/zsh"
        if [[ -x "${ZSH_BIN}" ]]; then
            if ! grep -qxF "${ZSH_BIN}" /etc/shells 2>/dev/null; then
                echo "==> Adding ${ZSH_BIN} to /etc/shells"
                echo "${ZSH_BIN}" | sudo tee -a /etc/shells >/dev/null
            fi
            CURRENT_SHELL="$(awk -F: -v u="$USER" '$1==u{print $7}' /etc/passwd)"
            if [[ "${CURRENT_SHELL}" != "${ZSH_BIN}" ]]; then
                echo "==> Setting default shell to ${ZSH_BIN}"
                sudo chsh -s "${ZSH_BIN}" "$USER"
            fi
        fi
        ;;
    *)
        echo "Unknown variant: {{ .variant }}" >&2
        exit 1
        ;;
esac
