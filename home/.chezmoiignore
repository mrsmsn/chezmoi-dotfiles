# Per-OS ignore rules can be added here using chezmoi template syntax.
# パターンは target (destination) 相対で書く (ソース名の dot_/private_ 前置ではない)。
# Example:
# {{ if ne .variant "darwin" }}
# .some_macos_only_file
# {{ end }}

{{- /* work プロファイル OFF (.work.gitdir_prefix が空) なら config_work は要らないので ignore する。
       パターンは target (destination) 相対。 */ -}}
{{- if not .work.gitdir_prefix }}
.config/git/config_work
{{- end }}

{{- if ne .variant "darwin" }}
Library
{{- end }}

{{- /* fcitx5+mozc / noctalia は NixOS 専用。他 variant には配らない。
       noctalia の設定実体は XDG_STATE (.local/state) 側で、settings.toml だけ管理し
       clipboard 履歴・plugins・runtime state は追跡しない。 */ -}}
{{- if ne .variant "nixos" }}
.config/fcitx5/config
.config/fcitx5/conf/mozc.conf
.local/state/noctalia/settings.toml
{{- end }}
